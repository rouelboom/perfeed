---
import '../styles/perfeed.css';
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import type { SiteEvent } from '../data/events';

interface Props {
  title: string;
  description: string;
  /** Прошедшее событие, страница которого показывается как документ в исходном дизайне perfeed. */
  event?: SiteEvent;
  image?: { src: string; width: number; height: number; alt: string };
}

const {
  title,
  description,
  event,
  image = { src: '/og-image.png', width: 550, height: 481, alt: '[золото, а не танец]' },
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image.src, Astro.site);
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#c8ff00" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:alt" content={image.alt} />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=2" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">К содержанию</a>
    <SiteHeader />
    {event && (
      <p class="archive-note">
        <span>прошедшее событие: {event.title}, {event.dateLabel}</span>
        <a href="/events/#past">все прошедшие события →</a>
      </p>
    )}
    <div class="perfeed-document">
      <slot />
    </div>
    <SiteFooter />
  </body>
</html>

<style>
  /* Ссылка «К содержанию» из perfeed.css должна быть над общей шапкой. */
  .skip-link { z-index: 40; }

  .archive-note {
    background: #8fb2c1;
    color: #111414;
    display: flex;
    flex-wrap: wrap;
    font: 400 0.8125rem/1.4 'Golos Text', 'Helvetica Neue', Arial, sans-serif;
    gap: 0.4rem 1.5rem;
    justify-content: space-between;
    margin: 0;
    padding: 0.65rem clamp(16px, 4vw, 48px);
  }
  .archive-note a { color: inherit; text-decoration: underline; text-underline-offset: 0.22em; }

  /* Шапка события perfeed позиционирована абсолютно и должна остаться внутри документа события, под общей шапкой. */
  .perfeed-document { position: relative; }
</style>
