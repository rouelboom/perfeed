<button class="scroll-top" type="button" aria-label="наверх страницы" hidden>
  <svg width="18" height="18" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25" aria-hidden="true"><path d="M8 13V3M3.5 7.5 8 3l4.5 4.5" /></svg>
</button>

<style>
  .scroll-top { align-items: center; background: var(--paper); border: 1px solid var(--ink); bottom: 1rem; color: var(--ink); cursor: pointer; display: inline-flex; height: 44px; justify-content: center; opacity: 1; position: fixed; right: 1rem; transition: background-color 0.18s ease, color 0.18s ease, opacity 0.2s ease, visibility 0.2s; width: 44px; z-index: 30; }
  .scroll-top[hidden] { opacity: 0; visibility: hidden; }
  .scroll-top:hover { background: var(--ink); color: var(--paper); }
  @media (min-width: 900px) { .scroll-top { bottom: 2rem; height: 48px; right: 2rem; width: 48px; } }
  @media (prefers-reduced-motion: reduce) { .scroll-top { transition: none; } }
</style>

<script>
  const button = document.querySelector<HTMLButtonElement>('.scroll-top');
  if (button) {
    // Кнопка нужна только после первого экрана: в начале страницы она лишь перекрывает контент.
    const update = () => { button.hidden = scrollY < innerHeight; };
    addEventListener('scroll', update, { passive: true });
    update();
    button.addEventListener('click', () => {
      scrollTo({ top: 0, behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
    });
  }
</script>
