---
import type { SiteEvent } from '../data/events';
import { effectiveStatus } from '../lib/event-status';
import EventFacts from './EventFacts.astro';

interface Props { event: SiteEvent }
const { event } = Astro.props;
const date = event.type === 'regular_group' ? event.dateLabel : event.startDate && new Date(event.startDate).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', timeZone: 'UTC' });
const rub = (amount: number) => `${amount.toLocaleString('ru-RU')} ₽`;
const registrationOpen = effectiveStatus(event) === 'open' && event.registrationUrl;
---

<article class="class-card" id={`class-${event.slug}`}>
  <div class="class-card__summary">
    <div class="class-card__heading">
      <h3 class="class-card__title"><a href={`/events/${event.slug}/`}>{event.title}</a></h3>
      <p class="class-card__date"><time datetime={event.startDate}>{date ?? 'дата пока не объявлена'}</time></p>
    </div>
    <EventFacts event={event} showPrice={false} showParticipants={false} />
  </div>
  <div class="class-card__cost">
    {event.price && <div class="class-card__price">
      <p>{rub(event.price.base)}</p>
      {event.price.student && <p class="class-card__student">студентам — {rub(event.price.student)}</p>}
    </div>}
    {event.price?.deposit && <p class="small">Предоплата {rub(event.price.deposit)} закрепляет место в группе и входит в общую стоимость.</p>}
  </div>
  <div class="class-card__actions">
    {registrationOpen ?
      <a class="button" href={event.registrationUrl} aria-label={`Записаться: ${event.title}, ${date}`}>{event.type === 'regular_group' ? 'записаться в группу' : `записаться на ${date}`} <svg width="16" height="16" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><path d="M3 13 13 3M3 3h10v10" /></svg></a>
    : <p class="small muted">{effectiveStatus(event) === 'closed' ? 'запись закрыта' : 'запись пока не открыта'}</p>}
  </div>
  <div class="class-card__more">
    {event.sessions && <details class="disclosure">
      <summary>все даты встреч</summary>
      <ol class="disclosure__body class-card__sessions">
        {event.sessions.map(({ date, time }) => <li><time datetime={date}>{new Date(date).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', weekday: 'short', timeZone: 'UTC' })}</time><span class="muted">{time ?? 'время уточняется'}</span></li>)}
      </ol>
    </details>}
    <a class="arrow-link small" href={`/events/${event.slug}/`}>подробнее {event.type === 'regular_group' ? 'о регулярной группе' : 'о классе'} <span aria-hidden="true">→</span></a>
    {event.nextIntakeLabel && <p class="small muted">{event.nextIntakeLabel}</p>}
  </div>
</article>

<style>
  .class-card { border-top: 2px solid var(--ink); display: flex; flex-direction: column; gap: 1rem; min-width: 0; padding-block: 1.25rem; }
  .class-card__summary { align-content: start; display: grid; gap: 1rem; }
  .class-card__heading { display: grid; gap: 0.6rem; }
  .class-card__title { font-size: 1.125rem; }
  .class-card__title a { text-decoration: none; }
  .class-card__title a:hover { text-decoration: underline; }
  .class-card__date { font-size: clamp(2rem, 3vw, 3rem); font-variant-numeric: tabular-nums; font-weight: 500; letter-spacing: -0.045em; line-height: 1; }
  .class-card__cost { align-content: start; border-top: 1px solid var(--rule); display: grid; gap: 1rem; padding-top: 1rem; }
  .class-card__price { display: grid; gap: 0.2rem; }
  .class-card__price p { font-size: 1.75rem; font-variant-numeric: tabular-nums; font-weight: 500; line-height: 1.2; }
  .class-card__price .class-card__student { font-size: 1rem; font-weight: 400; }
  .class-card__actions { display: grid; gap: 0.35rem; justify-items: start; }
  .class-card__more { display: flex; flex-direction: column; gap: 1rem; }
  .class-card__sessions { font-size: 0.875rem; }
  .class-card__sessions li { display: flex; flex-wrap: wrap; gap: 0.15rem 0.75rem; justify-content: space-between; }
  @media (min-width: 900px) {
    .class-card { align-items: start; display: grid; grid-row: span 4; grid-template-rows: subgrid; }
  }
</style>
