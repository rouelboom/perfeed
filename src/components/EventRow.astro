---
import { eventStatusLabels, type SiteEvent } from '../data/events';

interface Props {
  event: SiteEvent;
}

const { event } = Astro.props;
const rub = (amount: number) => `${amount.toLocaleString('ru-RU')} ₽`;
const weekdays = event.sessions
  ? [...new Set(event.sessions.map(({ date }) => new Date(date).toLocaleDateString('ru-RU', { weekday: 'long', timeZone: 'UTC' })))].join(' + ')
  : undefined;

const facts = [
  ['когда', weekdays],
  ['время', event.time],
  ['где', event.location],
  ['группа', [event.capacity && `до ${event.capacity} человек`, event.age].filter(Boolean).join(' · ') || undefined],
  ['стоимость', event.price && [rub(event.price.base), event.price.student && `студенты — ${rub(event.price.student)}`].filter(Boolean).join(', ')],
  ['предоплата', event.price?.deposit && rub(event.price.deposit)],
].filter((fact): fact is [string, string] => Boolean(fact[1]));

const action = event.status === 'open'
  ? { label: event.type === 'regular_group' ? 'подробнее / записаться' : 'записаться', href: event.registrationUrl ?? '/#join' }
  : event.status === 'upcoming'
    ? { label: 'о формате', href: '/#context' }
    : undefined;
---

<article class="event">
  <p class:list={['event__date', { 'event__date--soon': !event.startDate }]}>{event.dateLabel ?? eventStatusLabels.upcoming}</p>
  <h3 class="event__title">{event.title}</h3>
  <div class="event__info">
    {facts.length > 0 && (
      <dl>{facts.map(([term, value]) => <><dt>{term}</dt><dd>{value}</dd></>)}</dl>
    )}
    <p>{event.description}</p>
  </div>
  {action
    ? <p class="event__action"><a class="arrow-link" href={action.href}>{action.label} <span aria-hidden="true">→</span></a></p>
    : event.status === 'closed' && <p class="event__action muted">{eventStatusLabels.closed}</p>}
</article>

<style>
  .event { column-gap: var(--gap); display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); padding-block: 1.5rem 2rem; row-gap: 0.9rem; }
  /* Явно по классам: scoped-селектор `.event > *` получил бы большую специфичность и перебил раскладку ниже. */
  .event__date, .event__title, .event__info, .event__action { grid-column: 1 / -1; min-width: 0; }
  .event__date { font-size: clamp(2.2rem, 5vw, 4rem); font-variant-numeric: tabular-nums; font-weight: 500; letter-spacing: -0.04em; line-height: 0.9; }
  .event__date--soon { color: var(--on-blue-muted); }
  .event__title { font-size: 1.375rem; line-height: 1.15; }
  .event__info { display: grid; font-size: 0.9375rem; gap: 0.9rem; }
  .event__info dl { display: grid; gap: 0.2rem 1rem; grid-template-columns: max-content 1fr; }
  .event__info dt { color: var(--on-blue-muted); }

  @media (min-width: 900px) {
    .event { grid-template-columns: repeat(12, minmax(0, 1fr)); padding-block: 1.75rem 2.25rem; }
    .event__date { grid-column: 1 / 4; }
    .event__title { grid-column: 4 / 7; }
    .event__info { grid-column: 7 / 10; }
    .event__action { grid-column: 10 / 13; justify-self: end; text-align: right; }
    .event__date, .event__title, .event__info, .event__action { grid-row: 1; }
    .event__action { align-self: end; }
  }
</style>
