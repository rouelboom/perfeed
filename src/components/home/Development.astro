---
import { development } from '../../data/home';
---
<section class="section" id="development" aria-labelledby="development-title">
  <div class="wrap grid">
    <h2 class="section__title" id="development-title">{development.title}</h2>
    <div class="section__body">
      <p>{development.lead}</p>
      <ul class="text-list development__items">{development.items.map(([title, text]) => <li class="text-list__item"><h3>{title}</h3><p>{text}</p></li>)}</ul>
      <p>{development.closing}</p>
    </div>
  </div>
</section>
<style>
  .development__items { margin-block: 0.75rem; }
  @media (min-width: 1100px) { .development__items { column-gap: 2rem; grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
