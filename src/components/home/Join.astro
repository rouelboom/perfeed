---
import { currentClasses } from '../../data/events';
import { join, program } from '../../data/home';
import { site } from '../../config/site';
import { effectiveStatus } from '../../lib/event-status';
const available = currentClasses().filter((event) => effectiveStatus(event) === 'open' && event.registrationUrl);
const event = available.find(({ type }) => type === 'open_class') ?? available[0];
const isOpenClass = event?.type === 'open_class';
const date = event?.startDate && (isOpenClass ? new Date(event.startDate).toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', timeZone: 'UTC' }) : event.dateLabel);
const rub = (amount: number) => `${amount.toLocaleString('ru-RU')} ₽`;
---
<section class="join wrap grid" id="join" aria-labelledby="join-title">
  <h2 class="join__title" id="join-title">{event ? isOpenClass ? join.openTitle : join.groupTitle : 'присоединиться к практике'}</h2>
  <div class="join__body">
    {event ? <>
      <p>{isOpenClass ? join.openText : join.groupText}</p>
      <div class="join__facts"><p class="join__date">{date}</p><p>{[event.time, event.location].filter(Boolean).join(' · ')}</p><p class="small">{event.age} · опыт не требуется</p></div>
      {event.price && <p class="join__price">{rub(event.price.base)}{event.price.student && <span>студентам — {rub(event.price.student)}</span>}</p>}
      <a class="button" href={event.registrationUrl}>{isOpenClass ? `записаться на ${date}` : 'записаться в группу'} <span aria-hidden="true">↗</span></a>
      <a class="arrow-link small" href="#classes">посмотреть все занятия ↑</a>
    </> : <><p>{program.empty}</p><a class="button" href={site.contacts.find(({ href }) => href.includes('t.me'))?.href}>анонсы в Telegram ↗</a></>}
  </div>
</section>
<style>
  .join { border-top: 1px solid var(--ink); margin-top: var(--section); padding-block: clamp(2.5rem, 6vw, 5rem); row-gap: 1.5rem; }
  .join__title { font-size: clamp(2rem, 4vw, 3.5rem); letter-spacing: -0.04em; line-height: 1.05; }
  .join__body { display: grid; gap: 1.25rem; justify-items: start; }
  .join__facts { display: grid; gap: 0.3rem; }
  .join__date { font-size: 1.5rem; font-weight: 500; }
  .join__price { font-size: 2rem; font-variant-numeric: tabular-nums; font-weight: 500; line-height: 1.2; }
  .join__price span { display: block; font-size: 1rem; font-weight: 400; margin-top: 0.3rem; }
  @media (min-width: 900px) { .join__title { grid-column: 1 / 5; } .join__body { grid-column: 6 / 13; } }
</style>
