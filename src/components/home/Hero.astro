---
import { Image } from 'astro:assets';
import heroImage from '../../assets/unlimited-position/floor-flash.jpg';
import { site } from '../../config/site';
---

<section class="hero wrap grid" aria-labelledby="site-title">
  <h1 class="hero__title" id="site-title">unlimited position <span>/ запредельная позиция</span></h1>
  <Image
    class="hero__image"
    src={heroImage}
    alt="Танцовщица опирается ладонью о голубой пол, свет вспышки падает сбоку"
    widths={[640, 960, 1280]}
    sizes="(min-width: 900px) 58vw, 84vw"
    priority
  />
  <div class="hero__side">
    <p>практика современного танца<br /><span class="muted">{site.city}</span></p>
    <p><a class="arrow-link" href="#program">актуальная программа <span aria-hidden="true">↓</span></a></p>
  </div>
</section>

<style>
  .hero { padding-top: clamp(2rem, 6vw, 4.5rem); row-gap: 2rem; }
  .hero__title { font-size: clamp(3.1rem, 11.5vw, 10.5rem); letter-spacing: -0.045em; line-height: 0.86; }
  .hero__title span { color: var(--grey); display: block; }
  .hero__image { grid-column: 2 / -1; width: 100%; }
  .hero__side { display: grid; font-size: 0.9375rem; gap: 1.5rem; }

  @media (min-width: 900px) {
    .hero__image { grid-column: 6 / 13; grid-row: 2; }
    .hero__side { align-self: start; grid-column: 1 / 5; grid-row: 2; }
  }
</style>
