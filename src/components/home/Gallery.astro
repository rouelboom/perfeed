---
import { Image } from 'astro:assets';
import Carousel from '../Carousel.astro';
import duo from '../../../content/unlimited-position-photos/2026-10-23 20.10.14.jpg';
import alone from '../../../content/unlimited-position-photos/2026-10-23 20.13.34.jpg';
import circle from '../../assets/unlimited-position/circle.jpg';
import { gallery } from '../../data/home';
import { testimonials } from '../../data/testimonials';
const photos = [
  { src: duo, alt: 'Двое танцуют в паре, вытянув руки в одну сторону' },
  { src: alone, alt: 'Танцующий низко склонился к полу у стены, опираясь на руки' },
  { src: circle, alt: 'Участники сидят кругом на голубом полу зала' },
];
const firstPhotos = ['2026-10-23 20.10.26.jpg', '2026-10-23 20.13.29.jpg', '2026-10-23 20.11.55.jpg'];
const carouselPhotos = Object.entries(import.meta.glob<{ default: ImageMetadata }>('../../../content/unlimited-position-photos/*.jpg', { eager: true }))
  .map(([path, module]) => ({ name: path.split('/').pop()!, src: module.default }))
  .filter(({ src }) => !photos.some((photo) => photo.src.src === src.src));
// Имена файлов — время съёмки. Шаг золотого сечения по хронологии разводит соседние кадры одной серии подальше друг от друга.
const shuffled = carouselPhotos
  .filter(({ name }) => !firstPhotos.includes(name))
  .sort((first, second) => first.name.localeCompare(second.name))
  .map((photo, index) => ({ ...photo, order: (index * 0.618034) % 1 }))
  .sort((first, second) => first.order - second.order);
const morePhotos = [...firstPhotos.flatMap((name) => carouselPhotos.filter((photo) => photo.name === name)), ...shuffled].map(({ src }) => src);
---
<section class="section" id="in-class" aria-labelledby="in-class-title">
  <div class="wrap grid"><h2 class="section__title" id="in-class-title">{gallery.title}</h2></div>
  <div class="wrap gallery__photos">{photos.map(({ src, alt }) => <figure><Image src={src} alt={alt} widths={[480, 720, 1000]} sizes="(min-width: 900px) 32vw, 100vw" /></figure>)}</div>
  {morePhotos.length > 0 && <div class="wrap gallery__more"><Carousel items={morePhotos.map((src, index) => ({ src, alt: `Фото с занятия ${index + 1} из ${morePhotos.length}` }))} label="ещё фото с занятий" columns={3} sizes="(min-width: 900px) 32vw, 100vw" /></div>}
  <div class="wrap grid gallery__reviews">
    <h3 class="gallery__reviews-title">{gallery.reviewsTitle}</h3>
    <div class="gallery__quotes">{testimonials.map(({ paragraphs, author }) => <figure class="gallery__quote"><blockquote>{paragraphs.map((paragraph) => <p>{paragraph}</p>)}</blockquote><figcaption class="small muted">{author}</figcaption></figure>)}</div>
  </div>
</section>
<style>
  .gallery__photos { display: grid; gap: 1.5rem var(--gap); margin-top: 1.5rem; }
  .gallery__photos figure { display: grid; gap: 0.5rem; }
  .gallery__photos img { aspect-ratio: 3 / 2; object-fit: cover; width: 100%; }
  .gallery__more { margin-top: 1.5rem; }
  .gallery__reviews { margin-top: 2.5rem; row-gap: 1.5rem; }
  .gallery__quotes { align-items: start; display: grid; gap: 2rem; }
  .gallery__quote { border-left: 2px solid var(--blue); display: grid; gap: 0.75rem; padding-left: 1.25rem; }
  .gallery__quote blockquote { display: grid; font-size: 1.0625rem; gap: 1rem; line-height: 1.55; margin: 0; }
  .gallery__quote p { white-space: pre-line; }
  @media (min-width: 900px) { .gallery__photos { grid-template-columns: repeat(3, minmax(0, 1fr)); } .gallery__reviews-title { grid-column: 1 / 4; } .gallery__quotes { grid-column: 5 / 13; grid-template-columns: repeat(2, minmax(0, 1fr)); } .gallery__quote:last-child { grid-column: 1 / -1; } }
</style>
