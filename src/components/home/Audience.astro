---
import { audience } from '../../data/home';
---

<section class="section" id="audience" aria-labelledby="audience-title">
  <div class="wrap grid">
    <h2 class="section__title" id="audience-title">{audience.title}</h2>
    <div class="section__body audience">
      <div class="audience__main">
        <p class="audience__lead">{audience.lead}</p>
        <ul class="audience__needs">{audience.needs.map((item) => <li>{item}</li>)}</ul>
        <p class="muted">{audience.experienced}</p>
        <div class="audience__formats">
          {audience.formats.map(([title, text]) => <div><h3>{title}</h3><p>{text}</p></div>)}
        </div>
      </div>
      <p class="audience__age" aria-label="возраст: от 18 лет">18+</p>
    </div>
  </div>
</section>

<style>
  .audience { gap: 2rem; }
  .audience__main { display: grid; gap: 1.25rem; }
  .audience__lead { font-size: clamp(1.35rem, 2.4vw, 2rem); letter-spacing: -0.015em; line-height: 1.2; max-width: 26ch; }
  .audience__needs { border-top: 1px solid var(--rule); margin-top: 0.75rem; }
  .audience__needs li { border-bottom: 1px solid var(--rule); padding-block: 0.7rem; }
  .audience__formats { display: grid; gap: 1.5rem; margin-top: 1.75rem; }
  .audience__formats h3 { font-size: 1.25rem; }
  .audience__age { color: var(--blue); font-size: clamp(4rem, 12vw, 10rem); font-weight: 500; letter-spacing: -0.05em; line-height: 0.8; }

  @media (min-width: 600px) { .audience__formats { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 900px) {
    .audience { grid-template-columns: 2fr 1fr; }
    .audience__age { justify-self: end; }
  }
</style>
