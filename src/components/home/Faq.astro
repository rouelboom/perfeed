---
import { faq } from '../../data/home';
import { site } from '../../config/site';
---

<section class="section" id="faq" aria-labelledby="faq-title">
  <div class="wrap grid">
    <h2 class="section__title" id="faq-title">{faq.title}</h2>
    <div class="section__body faq">
      {faq.items.map(([question, answer]) => (
        <details>
          <summary>{question}</summary>
          <div class="faq__answer">{answer.map((paragraph) => <p>{paragraph}</p>)}</div>
        </details>
      ))}
      <p class="faq__contact"><a class="arrow-link" href={site.authorContacts[0].href}>задать другой вопрос Насте →</a></p>
    </div>
  </div>
</section>

<style>
  .faq { gap: 0; }
  .faq details { border-bottom: 1px solid var(--rule); }
  .faq details:first-child { border-top: 1px solid var(--ink); }
  .faq summary { cursor: pointer; display: grid; font-size: 1.125rem; font-weight: 500; gap: 1rem; grid-template-columns: minmax(0, 1fr) 1.5rem; list-style: none; padding-block: 1.05rem; }
  .faq summary::-webkit-details-marker { display: none; }
  .faq summary::after { color: var(--blue); content: '+'; font-size: 1.4rem; font-weight: 400; line-height: 1; text-align: right; }
  .faq details[open] summary::after { content: '−'; }
  .faq__answer { color: #2c3133; display: grid; gap: 0.75rem; padding-bottom: 1.4rem; }
  .faq__contact { margin-top: 1rem; }

  @media (min-width: 900px) { .faq { grid-column: 5 / 13; } }
</style>
