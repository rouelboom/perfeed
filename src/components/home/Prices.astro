---
import { currentEvents } from '../../data/events';
import { prices } from '../../data/home';

const rub = (amount: number) => `${amount.toLocaleString('ru-RU')} ₽`;
const events = currentEvents();
const group = events.find(({ type, price }) => type === 'regular_group' && price);
const openClass = events.find(({ type, price }) => type === 'open_class' && price);

const month = group?.startDate && new Date(group.startDate).toLocaleDateString('ru-RU', { month: 'long', timeZone: 'UTC' });

const rows = [
  group?.price && ['регулярная группа', `${month}, ${group.sessions?.length} встреч`, rub(group.price.base)],
  group?.price?.student && ['студенты', `регулярная группа, ${month}`, rub(group.price.student)],
  group?.price?.deposit && ['предоплата', 'входит в стоимость', rub(group.price.deposit)],
  openClass?.price && ['открытый класс', 'одна встреча', rub(openClass.price.base)],
].filter((row): row is [string, string, string] => Boolean(row));
---

<section class="section" id="prices" aria-labelledby="prices-title">
  <div class="wrap grid">
    <h2 class="section__title" id="prices-title">{prices.title}</h2>
    <div class="section__body prices">
      <dl>
        {rows.map(([title, note, price]) => (
          <div class="prices__row"><dt>{title}<span>{note}</span></dt><dd>{price}</dd></div>
        ))}
      </dl>
      <p class="small muted">{prices.note}</p>
    </div>
  </div>
</section>

<style>
  .prices dl { border-top: 1px solid var(--ink); }
  .prices__row { align-items: baseline; border-bottom: 1px solid var(--rule); display: grid; gap: 1rem; grid-template-columns: minmax(0, 1fr) auto; padding-block: 1rem; }
  .prices__row dt span { color: var(--grey); display: block; font-size: 0.9375rem; }
  .prices__row dd { font-size: clamp(1.5rem, 3vw, 2.25rem); font-variant-numeric: tabular-nums; font-weight: 500; letter-spacing: -0.03em; white-space: nowrap; }

  @media (min-width: 900px) { .prices { grid-column: 4 / 10; } }
</style>
