---
import Carousel from '../Carousel.astro';
import { practice } from '../../data/home';

// Слайды пронумерованы в порядке показа: 1.jpg, 2.jpg … 10.jpg.
const alts: Record<number, string> = {
  1: 'Прыжок над голубым полом, вид сверху; надпись «unlimited position / запредельная позиция»',
  2: 'Руки тянутся над голубым полом',
  3: 'Текст: «меня интересует позиция как временное состояние. то, где я нахожусь сейчас, влияет на то, как я могу двигаться дальше.»',
  4: 'Тело в движении на голубом полу, вид сверху',
  5: 'Текст: «мы никогда не начинаем с нейтрального тела. каждый человек приходит в практику со своей телесной историей. всё это уже является знанием.»',
  6: 'Танцовщица опирается на пол; рядом нарисована линия с точкой',
  7: 'Стопы и руки над голубым полом; текст: «кто предлагает движение. чьё тело становится образцом. кто смотрит и кто оказывается увиденным. кому принадлежит решение о том, что происходит дальше.»',
  8: 'Текст: «запредельность возникает в способности позиции оставаться подвижной. каждое положение содержит возможность продолжения.»; линия с точкой',
  9: 'Руки и стопы касаются голубого пола',
  10: 'Танцовщица на полу; вокруг тела нарисована орбита с точкой',
};
const slides = Object.entries(import.meta.glob<{ default: ImageMetadata }>('../../../content/unlimited-position-photos/up-description/*.jpg', { eager: true }))
  .map(([path, module]) => ({ number: Number(path.match(/(\d+)\.jpg$/)?.[1]), src: module.default }))
  .sort((first, second) => first.number - second.number)
  .map(({ number, src }) => ({ src, alt: alts[number] ?? 'Слайд о практике unlimited position' }));
---
<section class="section" id="practice" aria-labelledby="practice-title">
  <div class="wrap grid">
    <div class="practice__aside">
      <h2 class="section__title" id="practice-title">{practice.title}</h2>
      <div class="practice__slides"><Carousel items={slides} label="unlimited position в фотографиях" aspect="1280 / 905" sizes="(min-width: 900px) 30vw, 100vw" quality={95} /></div>
    </div>
    <div class="section__body practice__body">
      {practice.parts.map(({ title, text }) => <div class="practice__part stack"><h3>{title}</h3>{text.map((paragraph) => <p>{paragraph}</p>)}</div>)}
    </div>
  </div>
</section>
<style>
  /* На мобильном слайды уходят под текст, на десктопе липнут в левой колонке вместе с заголовком. */
  .practice__aside { display: contents; }
  .practice__aside .section__title, .practice__slides { grid-column: 1 / -1; min-width: 0; }
  .practice__slides { margin-top: 2.5rem; order: 1; }
  .practice__body { gap: 2.5rem; }
  @media (min-width: 900px) {
    .practice__aside { align-self: start; display: grid; grid-column: 1 / 5; position: sticky; top: 6rem; }
    .practice__aside .section__title { position: static; }
    .practice__slides { margin-top: 0; }
  }
  .practice__part h3 { font-size: 1.25rem; font-weight: 500; letter-spacing: -0.02em; }
</style>
