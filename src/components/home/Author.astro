---
import { Image } from 'astro:assets';
import portrait from '../../../content/photos/actor2.jpg';
import { author } from '../../data/home';
import { site } from '../../config/site';
---
<section class="section" id="about" aria-labelledby="about-title">
  <div class="wrap grid author">
    <div class="author__heading"><h2 class="author__name" id="about-title">{author.name}</h2><p class="muted">{author.role}</p></div>
    <Image class="author__photo" src={portrait} alt="Анастасия Сенокосова" widths={[400, 640, 853]} sizes="(min-width: 900px) 30vw, 70vw" />
    <div class="author__bio">
      {author.bio.map((paragraph) => <p>{paragraph}</p>)}
      <div class="author__links"><a class="arrow-link" href="#approach">как я веду занятия ↓</a><a class="arrow-link" href="/about/">подробнее обо мне →</a><a class="arrow-link small" href={site.authorContacts[0].href}>{site.authorContacts[0].label} →</a></div>
    </div>
  </div>
</section>
<style>
  .author { row-gap: 1.5rem; }
  .author__heading { display: grid; gap: 0.6rem; }
  .author__name { font-size: clamp(2rem, 4.5vw, 4rem); letter-spacing: -0.045em; line-height: 1; }
  .author__photo { grid-column: 1 / 5; width: 100%; }
  .author__bio, .author__links { display: grid; gap: 1rem; }
  .author__links { gap: 0.25rem; justify-items: start; }
  @media (min-width: 900px) { .author__heading { grid-column: 5 / 13; } .author__photo { grid-column: 1 / 4; grid-row: 1 / 3; } .author__bio { grid-column: 5 / 13; } }
</style>
