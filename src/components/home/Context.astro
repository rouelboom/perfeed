---
import { currentEvents, isClass, pastEvents } from '../../data/events';
import { context } from '../../data/home';
import { site } from '../../config/site';
import EventList from '../EventList.astro';
const upcoming = currentEvents().filter((event) => !isClass(event));
const past = pastEvents().slice(0, 2);
---
<section class="section" id="context" aria-labelledby="context-title">
  <div class="wrap grid">
    <h2 class="section__title" id="context-title">{context.title}</h2>
    <div class="section__body">
      <p>{context.text}</p>
      {upcoming.length > 0 && <EventList items={upcoming.slice(0, 1)} descriptions />}
      <a class="arrow-link" href={site.contacts.find(({ href }) => href.includes('t.me'))?.href}>следить за анонсами в Telegram ↗</a>
      {past.length > 0 && <div class="context__past stack"><h3>прошедшие события</h3><EventList items={past} /></div>}
      <a class="arrow-link" href="/events/">все события →</a>
    </div>
  </div>
</section>
<style>.context__past { margin-top: 0.5rem; }</style>
