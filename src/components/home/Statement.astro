---
import { statement } from '../../data/home';
---
<section class="section" id="position" aria-labelledby="position-title">
  <div class="wrap grid">
    <h2 class="section__title" id="position-title">{statement.title}</h2>
    <div class="section__body">
      {statement.text.map((paragraph) => <p>{paragraph}</p>)}
      <details class="disclosure"><summary>подробнее о художественной позиции</summary><div class="disclosure__body">{statement.details.map((paragraph) => <p>{paragraph}</p>)}</div></details>
    </div>
  </div>
</section>
