---
import { Image } from 'astro:assets';
import lead from '../../../content/unlimited-position-photos/2026-10-23 20.11.08.jpg';
import { approach } from '../../data/home';
---
<section class="section" id="approach" aria-labelledby="approach-title">
  <div class="wrap grid">
    <h2 class="section__title" id="approach-title">{approach.title}</h2>
    <figure class="approach__photo">
      <Image src={lead} alt="Настя улыбается в центре зала, участники стоят вокруг" widths={[480, 720, 1000, 1280]} sizes="100vw" />
    </figure>
    <div class="section__body">
      {approach.text.map((paragraph) => <p>{paragraph}</p>)}
      <a class="arrow-link" href="/#classes">выбрать ближайшее занятие <span aria-hidden="true">↑</span></a>
    </div>
  </div>
</section>
<style>
  .approach__photo { margin-bottom: 1.75rem; }
  .approach__photo img { aspect-ratio: 3 / 2; object-fit: cover; width: 100%; }
  @media (min-width: 900px) { .approach__photo { display: none; } }
</style>
