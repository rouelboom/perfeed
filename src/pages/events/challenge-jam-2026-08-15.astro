---
import { Image } from 'astro:assets';
import { eventStatusLabels, getEvent } from '../../data/events';
import PerfeedLayout from '../../layouts/PerfeedLayout.astro';

const event = getEvent('challenge-jam-2026-08-15', 'perfeed-jam');
const { announcement, images } = event.perfeed;
const status = eventStatusLabels[event.status];
---

<PerfeedLayout title={`${event.title} — Perfeed`} description={event.description} event={event} image={{ src: '/og/challenge-jam-2026-08-15.jpg', width: 1200, height: 630, alt: 'Танцовщицы с золотой и серебряной фольгой' }}>
  <header class="archive-header">
    <a class="brand" href="/" aria-label="Perfeed — на главную страницу">PERFEED</a>
    <a class="text-link" href="/events/">К архиву <span aria-hidden="true">→</span></a>
  </header>

  <main id="content">
    <article>
      <section class="event-detail-hero" aria-labelledby="event-title">
        <Image class="event-detail-image" src={images.hero} alt="Танцовщицы с золотой и серебряной фольгой" widths={[640, 960, 1440, 1920]} sizes="100vw" priority />
        <div class="event-detail-heading">
          <p>{status}</p>
          <h1 id="event-title">{event.title}</h1>
        </div>
      </section>

      <section class="event-facts section-wide" aria-label="Сведения о мероприятии">
        <dl>
          <div><dt>Когда</dt><dd>{event.dateLabel}</dd></div>
          <div><dt>Где</dt><dd>{event.location}</dd></div>
          <div><dt>Статус</dt><dd>{status}</dd></div>
        </dl>
      </section>

      <section class="event-announcement section" aria-labelledby="announcement-title">
        <p class="section-label">Архив</p>
        <h2 id="announcement-title">Челлендж-джем</h2>
        <p class="event-opening">{announcement.opening}</p>
        <p class="event-intro">{announcement.intro}</p>
        <p class="event-duration">{announcement.duration}</p>

        <h3 class="event-subtitle">Роли участников</h3>
        <div class="event-roles">
          {announcement.roles.map(([title, text]) => <section><h4>{title}</h4><p>{text}</p></section>)}
        </div>

        <p class="event-collaboration">{announcement.collaboration}</p>
        <div class="event-artist">
          <Image src={images.artist} alt="Музыкант dub a yaga" widths={[640, 960, 1440]} sizes="(max-width: 720px) 100vw, 45vw" />
          <div>
            <p class="section-label">Музыкальная программа</p>
            <h3>{announcement.artist.name}</h3>
            {announcement.artist.bio.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </div>
      </section>

      {event.report && (
        <section class="event-report section" aria-labelledby="report-title">
          <p class="section-label">Воспоминания</p>
          <h2 id="report-title">Как прошло</h2>
          {event.report.map((paragraph) => <p>{paragraph}</p>)}
        </section>
      )}

      {event.gallery && (
        <section class="event-gallery section-wide" aria-labelledby="gallery-title">
          <p class="section-label">Материалы события</p>
          <h2 id="gallery-title">Галерея</h2>
          <div>{event.gallery.map(({ image, alt }) => <Image src={image} alt={alt} widths={[480, 720, 960]} sizes="(max-width: 720px) 100vw, 33vw" />)}</div>
        </section>
      )}

      <p class="event-back section-wide"><a class="text-link" href="/events/">Вернуться в архив <span aria-hidden="true">→</span></a></p>
    </article>
  </main>

  <footer class="archive-footer">
    <a class="brand" href="/">PERFEED</a>
    <a href="/events/">Архив мероприятий <span aria-hidden="true">↗</span></a>
  </footer>
</PerfeedLayout>
