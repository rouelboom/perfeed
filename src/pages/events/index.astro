---
import EventList from '../../components/EventList.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { currentEvents, isClass, pastEvents } from '../../data/events';
const current = currentEvents().filter((event) => !isClass(event));
const dated = current.filter(({ startDate }) => startDate);
const planned = current.filter(({ startDate }) => !startDate);
const past = pastEvents();
---
<BaseLayout title="события и архив — unlimited position" description="Просмотры, обсуждения и лаборатории. Ближайшие события и архив художественных проектов Анастасии Сенокосовой в Калуге.">
  <div class="wrap page-heading"><h1 class="page-heading__title">события и архив</h1><p>Встречи вокруг современного танца: знакомиться с работами художников, пробовать разные форматы и обсуждать увиденное.</p><a class="arrow-link" href="/#classes">ближайшие занятия и запись →</a></div>
  {dated.length > 0 && <section class="section" aria-labelledby="upcoming-title"><div class="wrap grid"><h2 class="section__title" id="upcoming-title">ближайшие события</h2><div class="section__body"><EventList items={dated} descriptions /></div></div></section>}
  {planned.length > 0 && <section class="section" aria-labelledby="planned-title"><div class="wrap grid"><h2 class="section__title" id="planned-title">планируемые встречи</h2><div class="section__body"><EventList items={planned} descriptions /></div></div></section>}
  <section class="section events__archive" id="past" aria-labelledby="past-title"><div class="wrap grid"><h2 class="section__title" id="past-title">прошедшие события</h2><div class="section__body">{past.length ? <EventList items={past} /> : <p>Здесь появится документация прошедших событий.</p>}</div></div></section>
</BaseLayout>
<style>.events__archive { padding-bottom: var(--section); }</style>
