---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { archivedEvents } from '../../data/archived-events';

const events = [...archivedEvents].sort((first, second) => second.date.localeCompare(first.date));
---

<BaseLayout title="Архив мероприятий — Perfeed" description="Прошедшие события лаборатории современного танца и перформанса Perfeed.">
  <header class="archive-header">
    <a class="brand" href="/" aria-label="Perfeed — на главную страницу">PERFEED</a>
    <a class="text-link" href="/">На главную <span aria-hidden="true">→</span></a>
  </header>

  <main id="content">
    <section class="archive-intro section-wide" aria-labelledby="archive-title">
      <p class="section-label">Perfeed · Калуга</p>
      <h1 id="archive-title">Архив<br />мероприятий</h1>
      <p>Здесь остаются прошедшие встречи, их анонсы и будущие материалы о том, как всё прошло.</p>
    </section>

    <section class="archive-events section" aria-labelledby="events-title">
      <h2 id="events-title" class="visually-hidden">Прошедшие мероприятия</h2>
      <ol class="archive-events-list">
        {events.map((event) => (
          <li>
            <a href={`/events/${event.slug}/`}>
              <time datetime={event.date}>{event.dateLabel}</time>
              <div>
                <p>{event.status}</p>
                <h3>{event.title}</h3>
                <span>{event.summary}</span>
              </div>
              <strong>Подробнее <span aria-hidden="true">↗</span></strong>
            </a>
          </li>
        ))}
      </ol>
    </section>
  </main>

  <footer class="archive-footer">
    <a class="brand" href="/">PERFEED</a>
    <a href="/">На главную <span aria-hidden="true">↗</span></a>
  </footer>
</BaseLayout>
