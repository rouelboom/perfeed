---
import PerfeedLayout from '../layouts/PerfeedLayout.astro';
import { site } from '../config/site';
---

<!-- Временная главная до шагов 6–7 плана: страница perfeed переехала на /events/zoloto-not-dance-2026/. -->
<PerfeedLayout title={site.title} description={site.description}>
  <main id="content" class="archive-intro section-wide">
    <h1>{site.name}</h1>
    <p>практика современного танца · {site.city}</p>
    <p><a class="text-link" href="/events/zoloto-not-dance-2026/">[золото, а не танец] — прошедшее событие →</a></p>
  </main>
</PerfeedLayout>
