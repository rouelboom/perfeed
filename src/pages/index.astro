---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { event } from '../data/event';

const nav = [
  ['О лаборатории', '#laboratory'],
  ['Программа', '#schedule'],
  ['Ведущие', '#hosts'],
  ['Стоимость', '#price'],
] as const;

const mobileNav = [
  ['О лаборатории', '#laboratory'],
  ['Программа', '#schedule'],
  ['Челлендж-джем', '#jam'],
  ['Ведущие', '#hosts'],
  ['Стоимость', '#price'],
  ['Наши друзья', '#partners'],
] as const;
---

<BaseLayout title={`${event.title} — Perfeed`} description={event.description}>
  <header class="site-header">
    <a class="brand" href="#top" aria-label="Perfeed — к началу страницы">PERFEED</a>
    <button class="mobile-menu-toggle" type="button" aria-controls="mobile-menu" aria-expanded="false">МЕНЮ <span aria-hidden="true">≡</span></button>
    <nav aria-label="Основная навигация">
      {nav.map(([label, href]) => <a href={href}>{label}</a>)}
    </nav>
    <a class="header-cta" href={event.links.laboratory}>Подать заявку</a>
  </header>

  <dialog class="mobile-menu" id="mobile-menu" aria-label="Навигация">
    <div class="mobile-menu-header">
      <p>НАВИГАЦИЯ</p>
      <button class="mobile-menu-close" type="button" aria-label="Закрыть меню">×</button>
    </div>
    <nav aria-label="Мобильная навигация">
      {mobileNav.map(([label, href]) => <a href={href}>{label}<svg class="button-arrow mobile-menu-arrow" aria-hidden="true" viewBox="0 0 16 16"><path d="M3 13 13 3M6 3h7v7" /></svg></a>)}
    </nav>
  </dialog>

  <main id="content">
    <section class="hero" id="top" aria-labelledby="hero-title">
      <Image class="hero-image" src={event.images.hero} alt="Две танцовщицы держатся за руки на зелёном поле" widths={[640, 960, 1440, 1920]} sizes="100vw" priority />
      <div class="hero-shade"></div>
      <div class="hero-content reveal hero-reveal">
        <p class="eyebrow">Лаборатория современного танца и перфоманса <span>·</span> {event.age}</p>
        <h1 id="hero-title">{event.title}</h1>
        <p class="hero-lead">Тело, движение и внимание — пространство, где рождается ценность</p>
        <div class="hero-facts">
          <span>{event.dates}</span><span>{event.city}</span>
        </div>
        <div class="hero-actions">
          <a class="button button-gold" href={event.links.laboratory}>Подать заявку на лабораторию <svg class="button-arrow" aria-hidden="true" viewBox="0 0 16 16"><path d="M3 13 13 3M6 3h7v7" /></svg></a>
          <a class="button button-outline hero-jam-button" href={event.links.challengeJam}>Подать заявку на челендж-джем <svg class="button-arrow" aria-hidden="true" viewBox="0 0 16 16"><path d="M3 13 13 3M6 3h7v7" /></svg></a>
        </div>
      </div>
      <p class="hero-scroll" aria-hidden="true">Листайте вниз <span>↓</span></p>
    </section>

    <section class="question section-wide" aria-labelledby="question-title">
      <div class="question-copy reveal">
        <p class="section-label">В поле зрения</p>
        <h2 id="question-title">Что мы считаем ценным?<br />Как это решение возникает?<br /><em>И сколько золота остаётся незамеченным каждый день?</em></h2>
      </div>
    </section>

    <section class="laboratory section" id="laboratory" aria-labelledby="laboratory-title">
      <div class="split-intro">
        <p class="section-label reveal">О лаборатории</p>
        <div class="prose reveal">
          <h2 id="laboratory-title">{event.title}</h2>
          {event.about.slice(0, 3).map((paragraph) => <p>{paragraph}</p>)}
          <p class="prose-emphasis">Лаборатория завершится открытым показом процесса исследования, который станет возможностью разделить со зрителями путь, пройденный участниками за время лаборатории.</p>
          <a class="text-link" href={event.links.laboratory}>Подать заявку на лабораторию <span aria-hidden="true">→</span></a>
        </div>
        <aside class="laboratory-note reveal" aria-label="Дополнение о лаборатории"><p>{event.about[3]}</p></aside>
      </div>
    </section>

    <section class="process section-wide" aria-labelledby="process-title">
      <div class="section-heading reveal"><h2 id="process-title">От первой встречи<br />к общему показу</h2></div>
      <ol class="process-list">
        {event.process.map((item, index) => (
          <li class="reveal">
            <span class="process-index">0{index + 1}</span>
            <p class="process-date">{item.date}</p>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </li>
        ))}
      </ol>
    </section>

    <section class="audience section">
      <div class="audience-image reveal"><Image src={event.images.movementPortrait} alt="Танцовщицы в совместной пластической позе" widths={[480, 720, 960]} sizes="(max-width: 720px) 100vw, 42vw" /></div>
      <div class="audience-copy reveal"><p class="section-label">Для кого</p><h2>Для тех, кто хочет посмотреть внимательнее</h2>{event.audience.map((paragraph) => <p>{paragraph}</p>)}<p class="highlight">Предыдущий опыт в танце или перформансе не является обязательным.</p></div>
    </section>

    <section class="outcomes section" aria-labelledby="outcomes-title">
      <div class="section-heading reveal"><h2 id="outcomes-title">В процессе лаборатории участник:</h2></div>
      <ul class="outcome-list">{event.outcomes.map((outcome, index) => <li class="reveal"><span>0{index + 1}</span>{outcome}</li>)}</ul>
    </section>

    <section class="jam section-wide" id="jam" aria-labelledby="jam-title">
      <div class="jam-image"><Image src={event.images.foilWide} alt="Танцовщицы с золотой и серебряной фольгой" widths={[640, 960, 1440, 1920]} sizes="100vw" /></div>
      <div class="jam-content reveal"><p class="section-label">15 августа · билибина 33 · 5 этаж / вход - свободный донейшн</p><h2 id="jam-title">Челлендж-джем<br />«Гнозис Текстур»</h2><p class="jam-opening">Это первое открывающее событие лаборатории</p><p class="jam-intro">Умопомрачительная практика танца, перформанса и импровизации. Исследуем восприятие во всех его проявлениях.</p><p class="jam-time">2 сета <span>×</span> 40 минут</p></div>
      <p class="jam-roles-intro">В рамках джема вы можете быть в любой из ролей:</p>
      <div class="jam-roles">{event.jamRoles.map(([title, text]) => <article class="reveal"><h3>{title}</h3><p>{text}</p></article>)}</div>
      <p class="jam-collaboration reveal"><span>джем пройдет в</span><span>коллаборации с</span><span>музыкантом dub a yaga</span></p>
      <div class="jam-artist" aria-label="Музыкальная программа">
        <div class="jam-artist-image reveal"><Image src={event.images.actor3} alt="dub a yaga" widths={[640, 960, 1440]} sizes="(max-width: 720px) 100vw, 45vw" /></div>
        <div class="jam-artist-copy reveal">
          <p class="section-label">Аля · dj 'dub a yaga'</p>
          <p>{event.jamArtist[0]}</p>
          <p>{event.jamArtist[1]}</p>
        </div>
      </div>
      <a class="button button-outline reveal" href={event.links.challengeJam}>Зарегистрироваться на челлендж-джем <svg class="button-arrow" aria-hidden="true" viewBox="0 0 16 16"><path d="M3 13 13 3M6 3h7v7" /></svg></a>
      <p class="jam-note">Отдельная регистрация, не является заявкой на лабораторию.</p>
    </section>

    <section class="format section" aria-labelledby="format-title">
      <div class="format-image reveal"><Image src={event.images.connection} alt="Танцовщицы соединены движением на зелёном поле" widths={[640, 960, 1440]} sizes="(max-width: 720px) 100vw, 55vw" /></div>
      <div class="format-copy reveal">
        <p class="section-label">Лаборатория</p>
        <h2 id="format-title">Четыре недели<br />общего исследования</h2>
        <dl>{event.format.map(([value, label]) => <div><dt>{value}</dt><dd>{label}</dd></div>)}</dl>
        <ol class="weeks-list">{event.weeks.map((week, index) => <li><span>Неделя {index + 1}</span>{week}</li>)}</ol>
      </div>
    </section>

    <section class="schedule section-wide" id="schedule" aria-labelledby="schedule-title">
      <div class="section-heading reveal"><p class="section-label">Программа лаборатории</p><h2 id="schedule-title">Расписание</h2></div>
      <table class="schedule-table reveal">
        <thead><tr><th>Дата</th><th>Тема</th><th>Ведущая</th></tr></thead>
        <tbody>
          {event.schedule.map(([date, topic, host]) => <tr><td data-label="Дата">{date}</td><td data-label="Тема">{topic}</td><td data-label="Ведущая">{host}</td></tr>)}
        </tbody>
      </table>
      <p class="schedule-note">Точное время и место на уточнении, информация скоро.</p>
    </section>

    <section class="showcase section-wide" aria-labelledby="showcase-title">
      <div class="showcase-copy reveal"><p class="section-label">3 октября</p><h2 id="showcase-title">Открытый показ<br />процесса исследования</h2><p>Движения, наблюдения, зарисовки и открытия, возникающие в течение месяца, станут материалом для открытого показа. Вместе с участниками мы соберём его из того, что окажется важным для группы, и разделим со зрителями общий опыт лаборатории.</p></div>
      <Image class="showcase-image reveal" src={event.images.foilPortrait} alt="Две танцовщицы среди золотой и серебряной фольги" widths={[480, 720, 960]} sizes="(max-width: 720px) 100vw, 45vw" />
    </section>

    <section class="hosts section" id="hosts" aria-labelledby="hosts-title">
      <p class="hosts-title reveal" id="hosts-title">Создатели, кураторы, педагоги</p>
      <div class="hosts-list">
        {event.hosts.map((host) => (
          <article class="reveal">
            <Image class="host-image" src={host.image} alt={host.alt} widths={[480, 720, 960]} sizes="(max-width: 720px) 100vw, 36vw" />
            <div class="host-copy"><h3>{host.name}</h3>{host.bio.map((paragraph) => <p>{paragraph}</p>)}</div>
          </article>
        ))}
      </div>
    </section>

    <section class="price section-wide" id="price" aria-labelledby="price-title">
      <div class="section-heading reveal"><p class="section-label">Участие</p><h2 id="price-title">Стоимость<br />лаборатории</h2></div>
      <div class="price-list">{event.prices.map(([name, period, cost, note]) => <article class="reveal"><p>{name}</p><span>{period}</span><strong>{cost}</strong><small>{note}</small></article>)}</div>
      <div class="price-details">
        <article class="price-detail reveal">
          <h3>Рассрочка</h3>
          <p>Мы понимаем, что оплатить всю сумму сразу не всегда удобно.</p>
          <p>Поэтому вы можете воспользоваться беспроцентной рассрочкой:</p>
          <p>Если вам нужен сплит (рассрочка) на 2-4 платежа - сообщите об этом в форме регистрации. Мы свяжемся с вами и постараемся подобрать удобный для вас формат оплаты;<br /></p>
        </article>
        <article class="price-detail reveal">
          <h3>Способ оплаты</h3>
          <p><strong>Оплата происходит после подтверждения участия. Мы свяжемся с вами после регистрации и согласуем удобное время и способ оплаты.</strong></p>
          <p><strong>Мы предпочитаем оплату наличными. Если этот вариант вам не подходит, пожалуйста, напишите нам — мы постараемся найти удобное решение.</strong></p>
        </article>
      </div>
      <a class="button button-gold reveal" href={event.links.laboratory}>Подать заявку на лабораторию <svg class="button-arrow" aria-hidden="true" viewBox="0 0 16 16"><path d="M3 13 13 3M6 3h7v7" /></svg></a>
    </section>

    <section class="final-cta section-wide" aria-labelledby="final-title">
      <p class="section-label reveal">5 сентября</p><h2 id="final-title" class="reveal">Увидимся<br /><em>в поле зрения.</em></h2><a class="button button-dark reveal" href={event.links.laboratory}>Подать заявку <svg class="button-arrow" aria-hidden="true" viewBox="0 0 16 16"><path d="M3 13 13 3M6 3h7v7" /></svg></a>
    </section>

    <section class="partners section-wide" id="partners" aria-labelledby="partners-title">
      <p class="partners-credit">Благодарим Алексея Климова за фотографии, использованные в оформлении проекта</p>
      <div class="section-heading reveal"><p class="section-label">Поддержка проекта</p><h2 id="partners-title">Информационные друзья</h2></div>
      <ul class="partners-list">
        {event.partners.map((partner) => (
          <li class="reveal">
            {'logo' in partner ? <Image class={`partner-logo ${partner.className ?? ''}`} src={partner.logo} alt={partner.alt} widths={[320, 480, 640]} sizes="(max-width: 720px) 50vw, 25vw" /> : partner.name}
          </li>
        ))}
      </ul>
    </section>

    <section class="contacts section-wide" aria-labelledby="contacts-title">
      <div class="section-heading reveal"><p class="section-label">На связи</p><h2 id="contacts-title">Контакты кураторов<br />для связи</h2></div>
      <div class="contacts-list">
        <article class="reveal">
          <h3>Настя</h3>
          <a href="tel:+79158962078">+7 915 896-20-78</a>
          <a href="mailto:naumovakk@gmail.com">naumovakk@gmail.com</a>
        </article>
        <article class="reveal">
          <h3>Саяна</h3>
          <a href="tel:+79038139232">+7 903 813-92-32</a>
          <a href="mailto:saya.kuzichkina@gmail.com">saya.kuzichkina@gmail.com</a>
        </article>
      </div>
    </section>
  </main>

  <footer class="site-footer">
    <div class="footer-heading">
      <a class="brand" href="#top">PERFEED</a>
      <p>Лаборатория современного танца и перформанса</p>
      <span>{event.age}</span>
    </div>
    <nav class="footer-socials" aria-label="Социальные сети">
      <a href="https://www.instagram.com/zoloto.dance.lab/" target="_blank" rel="noopener noreferrer">
        <span>Instagram*</span>
        <strong>@zoloto.dance.lab</strong>
        <svg class="button-arrow" aria-hidden="true" viewBox="0 0 16 16"><path d="M3 13 13 3M6 3h7v7" /></svg>
      </a>
      <a href="https://t.me/zoloto_dance_lab" target="_blank" rel="noopener noreferrer">
        <span>Telegram</span>
        <strong>[золото, а не танец]</strong>
        <svg class="button-arrow" aria-hidden="true" viewBox="0 0 16 16"><path d="M3 13 13 3M6 3h7v7" /></svg>
      </a>
      <a href="https://vk.ru/zoloto_dance_lab" target="_blank" rel="noopener noreferrer">
        <span>ВКонтакте</span>
        <strong>zoloto_dance_lab</strong>
        <svg class="button-arrow" aria-hidden="true" viewBox="0 0 16 16"><path d="M3 13 13 3M6 3h7v7" /></svg>
      </a>
    </nav>
    <p class="footer-disclaimer">* Instagram принадлежит компании Meta, деятельность которой признана экстремистской и запрещена на территории РФ.</p>
  </footer>

  <script>
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => entry.isIntersecting && entry.target.classList.add('is-visible'));
    }, { threshold: 0.12 });
    document.querySelectorAll('.reveal').forEach((element) => observer.observe(element));

    const menu = document.querySelector<HTMLDialogElement>('#mobile-menu');
    const menuToggle = document.querySelector<HTMLButtonElement>('.mobile-menu-toggle');
    const menuClose = document.querySelector<HTMLButtonElement>('.mobile-menu-close');

    const closeMenu = () => {
      menu?.close();
      menuToggle?.setAttribute('aria-expanded', 'false');
    };

    menuToggle?.addEventListener('click', () => {
      menu?.showModal();
      menuToggle.setAttribute('aria-expanded', 'true');
    });
    menuClose?.addEventListener('click', closeMenu);
    menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
  </script>
</BaseLayout>
