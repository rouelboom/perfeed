---
import Approach from '../components/home/Approach.astro';
import Adults from '../components/home/Adults.astro';
import Author from '../components/home/Author.astro';
import Context from '../components/home/Context.astro';
import Development from '../components/home/Development.astro';
import Gallery from '../components/home/Gallery.astro';
import Faq from '../components/home/Faq.astro';
import Hero from '../components/home/Hero.astro';
import Join from '../components/home/Join.astro';
import Practice from '../components/home/Practice.astro';
import Program from '../components/home/Program.astro';
import Statement from '../components/home/Statement.astro';
import Work from '../components/home/Work.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <script is:inline slot="head">
    // До переезда здесь была страница лаборатории perfeed, и ссылки на её разделы (/#schedule и т. п.) остались в соцсетях.
    (() => {
      const anchors = ['laboratory', 'schedule', 'hosts', 'partners', 'hero-title', 'question-title', 'audience-title', 'laboratory-title', 'process-title', 'outcomes-title', 'format-title', 'schedule-title', 'showcase-title', 'hosts-title', 'partners-title', 'contacts-title'];
      const anchor = decodeURIComponent(location.hash.slice(1));
      // У старой главной был только заголовок контактов, без id у самого раздела.
      if (anchor === 'contacts') location.replace('/events/zoloto-not-dance-2026/#contacts-title');
      else if (anchors.includes(anchor)) location.replace(`/events/zoloto-not-dance-2026/#${anchor}`);
    })();
  </script>
  <Hero />
  <Program />
  <Practice />
  <Work />
  <Development />
  <Author />
  <Approach />
  <Adults />
  <Gallery />
  <Context />
  <Statement />
  <Faq />
  <Join />
</BaseLayout>
